# LLM Configuration
LLM_PROVIDER=mock              # Options: openai, azure, mock
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4
AZURE_OPENAI_KEY=your-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment

# Embeddings Configuration
EMBEDDINGS_PROVIDER=mock       # Options: openai, huggingface, mock
OPENAI_EMBED_MODEL=text-embedding-3-small
HUGGINGFACE_MODEL=all-MiniLM-L6-v2

# Vector Store Configuration
FAISS_INDEX_PATH=knowledge_base/index
KB_FACTS_PATH=knowledge_base/confirmed_facts.yaml
KB_CONVENTIONS_PATH=knowledge_base/conventions.yaml
KB_HISTORY_PATH=knowledge_base/history.jsonl

# Processing
CHUNK_SIZE=256
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO                 # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/app.log
LOG_FORMAT=json                # Options: json, plain

# Output
OUTPUT_DIR=output
AUDIT_DIR=output/audit

# Features
INTERACTIVE_MODE=true
AUTO_CONFIRM_HIGH_CONFIDENCE=false
CONFIDENCE_THRESHOLD=0.85

# Mock Mode (for testing without APIs)
MOCK_MODE=false